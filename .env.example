# Turso / libSQL (plan Free). Dejar los overages desactivados: costo $0/mes.
# Producción: libsql://<tu-db>-<usuario>.turso.io + TURSO_AUTH_TOKEN real.
# Desarrollo local: file:./local.db + TURSO_AUTH_TOKEN=dummy (drizzle-kit exige token).
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=dummy

# Vercel Blob (plan FREE). Necesario para subir imágenes de propiedades.
# En local puede quedar vacío; en Vercel es obligatorio.
BLOB_READ_WRITE_TOKEN=

# Verificá las variables sin imprimir valores con: npm run env:check
# Nunca commites .env.local ni credenciales reales.
