# Turso / libSQL (plan Free)
# Producción: libsql://<tu-db>-<usuario>.turso.io
# Desarrollo local: file:./local.db
# drizzle-kit exige un token aunque sea local; usá "dummy".
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=dummy

# Vercel Blob (plan FREE). Necesario para subir imágenes de propiedades.
BLOB_READ_WRITE_TOKEN=
